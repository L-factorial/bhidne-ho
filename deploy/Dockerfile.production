# CI builds the frontend; application VMs only pull the finished image.
FROM node:22-bookworm-slim AS frontend
WORKDIR /client
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ ./
RUN npm run build:production && tar -czf /frontend.tar.gz -C dist .

FROM python:3.14-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
COPY app/ app/
COPY card_utils/ card_utils/
COPY callbreak/ callbreak/
COPY marriage/ marriage/
COPY flush/ flush/
RUN pip install --no-cache-dir '.[redis]' && useradd --uid 10001 --create-home bhidne
COPY --from=frontend /frontend.tar.gz /opt/bhidne-frontend.tar.gz
USER bhidne
EXPOSE 8080
CMD ["uvicorn", "app.durable_games.bootstrap:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
