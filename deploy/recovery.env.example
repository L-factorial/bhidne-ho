# Disabled unless all required values are supplied. Do not commit live credentials.
BHIDNE_HO_RECOVERY_ENABLED=0
BHIDNE_HO_RECOVERY_PUBLIC_ORIGIN=https://bhidne-ho.lfactorial.com
BHIDNE_HO_RECOVERY_FROM=accounts@example.com
BHIDNE_HO_RECOVERY_SMTP_HOST=smtp.example.com
BHIDNE_HO_RECOVERY_SMTP_PORT=587
BHIDNE_HO_RECOVERY_SMTP_TLS=starttls
BHIDNE_HO_RECOVERY_SMTP_USERNAME=
BHIDNE_HO_RECOVERY_SMTP_PASSWORD=
# Comma-separated Fernet keys, newest first. Generate outside source control.
BHIDNE_HO_RECOVERY_KEYS=
