# Append to private deploy/.env; never commit real credentials.
# Enable only the providers whose console registrations are ready.
BHIDNE_HO_SOCIAL_ENABLED_PROVIDERS=
BHIDNE_HO_SOCIAL_PUBLIC_URL=https://api-bhidne-ho.lfactorial.com
BHIDNE_HO_SOCIAL_REDIRECT_URIS=https://bhidne-ho.lfactorial.com/,bhidneho://auth
BHIDNE_HO_GOOGLE_WEB_CLIENT_ID=
BHIDNE_HO_GOOGLE_WEB_CLIENT_SECRET=
BHIDNE_HO_APPLE_SERVICE_ID=
# Apple-generated ES256 client-secret JWT. Rotate before its expiry.
BHIDNE_HO_APPLE_CLIENT_SECRET=
BHIDNE_HO_FACEBOOK_APP_ID=
BHIDNE_HO_FACEBOOK_APP_SECRET=
# Set a currently supported Graph API version from your Meta app (vNN.0).
BHIDNE_HO_FACEBOOK_GRAPH_VERSION=
