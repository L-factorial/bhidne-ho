{
  "expo": {
    "name": "Bhidne Ho",
    "slug": "bhidne-ho",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#091B30",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "name": "Bhidne Ho"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
